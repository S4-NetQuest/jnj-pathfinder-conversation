<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Node.js Environment Variables -->
    <add key="NODE_ENV" value="staging" />
    <add key="PORT" value="4343" />
    <add key="FRONTEND_URL" value="https://previews.s4stage.com/pathfinder" />

    <!-- Database Configuration -->
    <add key="DB_SERVER" value="CHUCK\SQL2K17" />
    <add key="DB_PORT" value="1434" />
    <add key="DB_NAME" value="JNJ-PATHFINDER-CONVERSATION" />
    <add key="DB_USER" value="sa" />
    <add key="DB_PASSWORD" value="PCxa6HgRCNBQPcAX" />
    <add key="DB_ENCRYPT" value="false" />
    <add key="DB_TRUST_CERT" value="true" />

    <!-- Session Configuration -->
    <add key="SESSION_SECRET" value="staging-super-secret-session-key-change-this" />

    <!-- Authentication Configuration -->
    <add key="ENABLE_MANUAL_LOGIN" value="true" />
    <add key="ENABLE_SAML" value="false" />
  </appSettings>

  <system.webServer>
    <!-- IISNode basic configuration -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs_other\nodejs_v22.16.0\node.exe&quot;"
      node_env="staging"
      loggingEnabled="true"
      logDirectory="logs"
      debuggingEnabled="true"
      devErrorsEnabled="true" />

    <!-- Simple handlers -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Rewrite rules with HTTPS redirect -->
    <rewrite>
      <rules>
        <!-- Redirect HTTP to HTTPS -->
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://pathfinder-api.s4stage.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Handle all other requests -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="server.js"/>
        </rule>
      </rules>
    </rewrite>

    <!-- Security settings -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".env.staging" />
          <add segment="logs" />
          <add segment="config" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- Enhanced CORS and security headers -->
    <httpProtocol>
      <customHeaders>
        <!-- Security Headers -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />

        <!-- Cache Control for API responses -->
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma" value="no-cache" />
      </customHeaders>
    </httpProtocol>

    <!-- Show detailed errors for debugging -->
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>