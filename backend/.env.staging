# .env.staging for pathfinder-api/s4stage.com
NODE_ENV=staging
PORT=4343
FRONTEND_URL=http://previews.s4stage.com/pathfinder

# Database Configuration - Update these for your staging server
DB_SERVER=CHUCK\\SQL2K17
DB_PORT=1434
DB_NAME=JNJ-PATHFINDER-CONVERSATION
DB_USER=sa
DB_PASSWORD=PCxa6HgRCNBQPcAX
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Session Configuration
SESSION_SECRET=staging-super-secret-session-key-change-this

# Authentication Configuration
ENABLE_MANUAL_LOGIN=true
ENABLE_SAML=false

# JWT Configuration
JWT_SECRET=staging-jwt-secret-key
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_RATE_LIMITING=true

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=false

# File Upload
MAX_FILE_SIZE=10485760

# Session Store
USE_SQL_SESSION_STORE=false

# Security
HTTPS_ENABLED=false

# Additional staging URLs
PRODUCTION_URL=